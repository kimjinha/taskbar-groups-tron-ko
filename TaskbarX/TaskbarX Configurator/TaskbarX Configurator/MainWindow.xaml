                                    <ui:NumberBox x:Name="NumericUpDown6" Text="6" Width="110" PreviewTextInput="NumberValidationTextBox"
                                                  ToolTip="Windows 시작 후 TaskbarX를 실행하기까지 기다릴 시간(초). 시작 때 안 뜨면 늘려 보세요." />
                                    <TextBlock Text="초" Style="{StaticResource Sub}" Margin="8,0,0,0" />
                                </StackPanel>
                                <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                                    <Button Content="작업 지우기" MinWidth="100" Click="Button_Click_3" ToolTip="TaskbarX 시작 작업(작업 스케줄러)을 지웁니다." />
                                    <Button Content="작업 만들기" MinWidth="100" Click="Button_Click_33" ToolTip="TaskbarX 시작 작업(작업 스케줄러)을 만듭니다." />
