                                <TextBox Grid.Row="3" Grid.Column="1" IsReadOnly="True" Text="https://github.com/ChrisAnd1998/TaskbarX" Margin="0,0,0,6" />
                                <TextBox Grid.Row="4" Grid.Column="1" IsReadOnly="True" Text="https://github.com/ChrisAnd1998/TaskbarX/issues" Margin="0,0,0,6" />
                                <TextBox Grid.Row="5" Grid.Column="1" IsReadOnly="True" Text="chrisand1998@gmail.com" Margin="0,0,0,6" />
                                <TextBox Grid.Row="6" Grid.Column="1" IsReadOnly="True" Text="u/chrisand1998" Margin="0,0,0,6" />
                                <TextBox Grid.Row="7" Grid.Column="1" IsReadOnly="True" TextWrapping="Wrap"
                                         Text="ModernWPF:  https://github.com/Kinnara/ModernWpf&#xD;&#xA;TaskScheduler:  https://github.com/dahall/TaskScheduler&#xD;&#xA;Emoji.Wpf:  https://github.com/samhocevar/emoji.wpf" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

