                                    <ui:NumberBox x:Name="NumericUpDown7_Copy" Text="0" Width="110" PreviewTextInput="NumberValidationTextBox"
                                                  ToolTip="건너뛸 해상도 2" />
                                    <ui:NumberBox x:Name="NumericUpDown7_Copy1" Text="0" Width="110" PreviewTextInput="NumberValidationTextBox"
