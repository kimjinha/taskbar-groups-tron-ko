            <DockPanel LastChildFill="False">
                <ui:SimpleStackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
                    <Button FontFamily="Segoe MDL2 Assets" Content="&#xE777;" FontSize="16" Width="40" Height="34" Click="Button_Click_6"
                            ToolTip="모든 설정을 기본값으로 되돌립니다. [적용]을 눌러야 확정됩니다." />
                    <Button FontFamily="Segoe MDL2 Assets" Content="&#xE895;" FontSize="16" Width="40" Height="34" Click="Button_Click_5"
                            ToolTip="지금 적용된 설정을 다시 불러옵니다." />
                    <CheckBox x:Name="checkboxconsole" Content="콘솔 표시" VerticalAlignment="Center" Margin="8,0,0,0"
                              ToolTip="문제 확인용 콘솔 창을 함께 띄웁니다." />
                </ui:SimpleStackPanel>
                <ui:SimpleStackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button Content="TaskbarX 다시 시작" Height="34" Click="Button_Click_7" ToolTip="TaskbarX 백그라운드 프로그램을 다시 시작합니다." />
                    <Button Content="TaskbarX 중지" Height="34" Click="Button_Click_2" ToolTip="TaskbarX 백그라운드 프로그램을 멈추고 아이콘을 왼쪽으로 되돌립니다." />
                    <Button Content="닫기" MinWidth="80" Height="34" Click="Button_Click" ToolTip="설정 창을 닫습니다." />
                    <Button Content="적용" MinWidth="90" Height="34" Style="{StaticResource AccentButtonStyle}" Click="Button_Click_1"
