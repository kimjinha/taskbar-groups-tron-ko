                                    <StackPanel>
                                        <RadioButton Content="MSAA" IsChecked="True" IsEnabled="False" ToolTip="Microsoft Active Accessibility로 작업 표시줄 정보를 읽습니다." />
                                        <RadioButton Content="UIAutomation" IsEnabled="False" ToolTip="UI Automation으로 작업 표시줄 정보를 읽습니다." />
                                    </StackPanel>
