                                        ToolTip="직접 바로 가기를 만들 때 쓸 인자를 생성합니다." />
                                <TextBlock Style="{StaticResource Sub}" Margin="0,12,0,0"
                                           Text="직접 시작 바로 가기를 만들려면 위의 시작 작업을 지우고 [적용] 버튼은 쓰지 마세요. [적용]을 누르면 시작 작업이 다시 만들어집니다." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 4 extra -->
            <TabItem>
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
