<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskbarXConfiguratorWPF"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        mc:Ignorable="d"
        Title="TaskbarX 설정" Width="900" Height="680" MinWidth="760" MinHeight="520"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        ContentRendered="Window_Loaded"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:TitleBar.Background="#FF0A0F14" ui:TitleBar.InactiveBackground="#FF0A0F14"
        ui:TitleBar.Foreground="#FFD8F6FF" ui:TitleBar.InactiveForeground="#FF7FA9B5"
        Icon="StoreLogo2-71.ico"
        Background="#FF0A0F14" Foreground="#FFD8F6FF" BorderBrush="#FF00E5FF" BorderThickness="2"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="14">

    <Window.Resources>
        <!-- TRON palette: bg #0A0F14, panel #0F1A22, line #0E3A44, accent #00E5FF, text #D8F6FF, sub #7FA9B5 -->
        <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI, Malgun Gothic</FontFamily>

        <!-- text on accent (cyan) background must be dark -->
        <SolidColorBrush x:Key="AccentButtonBackground" Color="#FF00E5FF" />
        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FF5CF0FF" />
        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#FF00B8CC" />
        <SolidColorBrush x:Key="AccentButtonForeground" Color="#FF0A0F14" />
        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FF0A0F14" />
        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FF0A0F14" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FF0A0F14" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FF0A0F14" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#FF0A0F14" />
        <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="#FF0A0F14" />
        <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver" Color="#FF0A0F14" />
        <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPressed" Color="#FF0A0F14" />

        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF00E5FF" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFD8F6FF" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF7FA9B5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FF0F1A22" />
            <Setter Property="BorderBrush" Value="#FF0E3A44" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- left menu item: 3px cyan bar + cyan text when selected, no cyan fill -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#FF7FA9B5" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid x:Name="root" Background="Transparent" Height="40">
                            <Rectangle x:Name="bar" Width="3" HorizontalAlignment="Left" Fill="#FF00E5FF" Visibility="Collapsed" />
                            <ContentPresenter Margin="18,0,8,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="#FF13242E" />
                                <Setter Property="Foreground" Value="#FFD8F6FF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="root" Property="Background" Value="#FF0A0F14" />
                                <Setter TargetName="bar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="#FF00E5FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- tabs are switched by the left menu; hide tab headers -->
        <Style TargetType="TabItem">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style x:Key="Page" TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Padding" Value="28,20,28,20" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Rectangle x:Name="placeholder" Fill="Transparent" Visibility="Collapsed" />

        <!-- ===== left menu ===== -->
        <Border Grid.Column="0" Grid.Row="0" Background="#FF0F1A22" BorderBrush="#FF0E3A44" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="TASKBARX" Foreground="#FF00E5FF" FontWeight="SemiBold" FontSize="13" Margin="20,16,0,10" />
                <ListBox x:Name="ListBox1" Background="Transparent" BorderThickness="0" Padding="0"
                         ItemContainerStyle="{StaticResource NavItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="ListBox_SelectionChanged">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE790;" />
                        <TextBlock Text="스타일" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="animation_Tab" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" />
                        <TextBlock Text="애니메이션" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7F4;" />
                        <TextBlock Text="위치" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7E8;" />
                        <TextBlock Text="시작" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" />
                        <TextBlock Text="기타" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE9F5;" />
                        <TextBlock Text="동작 방식" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE80F;" />
                        <TextBlock Text="시작 버튼" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" />
                        <TextBlock Text="정보" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" />
                        <TextBlock Text="제거" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== pages ===== -->
        <TabControl x:Name="TabControl1" Grid.Column="1" Grid.Row="0" Background="Transparent" BorderThickness="0" Padding="0"
                    Foreground="#FFD8F6FF">
            <TabControl.Resources>
                <!-- ModernWpf tab content does not inherit Foreground; give plain text the body color -->
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#FFD8F6FF" />
                </Style>
                <Style TargetType="ui:NumberBox" BasedOn="{StaticResource {x:Type ui:NumberBox}}">
                    <Setter Property="Background" Value="#FF0A0F14" />
                    <Setter Property="Foreground" Value="#FFD8F6FF" />
                </Style>
            </TabControl.Resources>

            <!-- 0 style -->
            <TabItem>
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Text="스타일" Style="{StaticResource H1}" />

                        <Border Style="{StaticResource Card}" BorderBrush="#FF00E5FF">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="btnTron" Content="⚡ 트론 테마" MinWidth="140" Height="34" Click="BtnTron_Click"
                                            Foreground="#FF00E5FF" BorderBrush="#FF00E5FF" BorderThickness="1"
                                            ToolTip="TRON: Legacy 프리셋 - 흑요석색(#0A0F14) 흐림 배경. 적용을 눌러야 반영됩니다." />
                                    <CheckBox x:Name="chkTronLine" Content="네온 선 켜기" Margin="20,0,0,0" VerticalAlignment="Center"
                                              ToolTip="작업 표시줄 안쪽 가장자리에 2px 시안(#00E5FF) 선을 그립니다. 전체 화면 앱이 있으면 숨깁니다." />
                                    <ComboBox x:Name="cbTronStyle" Margin="12,0,0,0" MinWidth="170" VerticalAlignment="Center" SelectedIndex="0"
                                              ToolTip="네온 선 테마를 고릅니다. 적용을 눌러야 반영됩니다.">
                                        <ComboBoxItem Content="빛 왕복" />
                                        <ComboBoxItem Content="고정 네온" />
                                        <ComboBoxItem Content="트론 오토바이" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="선 색" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox x:Name="cbTronColor" MinWidth="150" VerticalAlignment="Center" SelectedIndex="0" ToolTip="네온 선 색. 적용을 눌러야 반영됩니다.">
                                        <ComboBoxItem Content="시안 (기본)" />
                                        <ComboBoxItem Content="주황 (트론 악당)" />
                                        <ComboBoxItem Content="빨강" />
                                        <ComboBoxItem Content="초록" />
                                        <ComboBoxItem Content="보라" />
                                        <ComboBoxItem Content="흰색" />
                                    </ComboBox>
                                    <TextBlock Text="빛 번짐" VerticalAlignment="Center" Margin="20,0,8,0" />
                                    <Slider x:Name="sTronGlow" Width="160" Minimum="0" Maximum="20" Value="6" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            ToolTip="0 = 번짐 없음, 20 = 크게 번짐" />
                                    <TextBlock Text="{Binding Value, ElementName=sTronGlow}" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="20" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="움직임 속도" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Slider x:Name="sTronSpeed" Width="200" Minimum="1" Maximum="10" Value="5" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            ToolTip="1 = 아주 느리게, 5 = 기본, 10 = 아주 빠르게 (빛 왕복·트론 오토바이)" />
                                    <TextBlock Text="{Binding Value, ElementName=sTronSpeed}" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="20" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Sub}" Margin="0,8,0,0"
                                           Text="트론 테마는 배경을 어두운 흐림으로, 네온 선은 작업 표시줄 가장자리에 시안 선을 그립니다. 오른쪽 아래 [적용]을 눌러야 반영됩니다." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="배경 스타일" Style="{StaticResource H2}" Margin="0,0,0,4" />
                                <WrapPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RadioButton1" Content="기본" IsChecked="True" MinWidth="170" ToolTip="작업 표시줄 배경을 원래대로 둡니다." />
                                    <RadioButton x:Name="RadioButton2" Content="투명" MinWidth="170" ToolTip="작업 표시줄 배경을 완전히 투명하게 합니다." />
                                    <RadioButton x:Name="RadioButtontc" Content="투명 그라데이션" MinWidth="170" ToolTip="아래 색으로 투명 그라데이션 배경을 씁니다." />
                                    <RadioButton x:Name="RadioButtonoq" Content="불투명" MinWidth="170" ToolTip="아래 색으로 불투명 배경을 씁니다." />
                                    <RadioButton x:Name="RadioButton3" Content="흐림(Blur)" MinWidth="170" ToolTip="아래 색으로 흐림 배경을 씁니다." />
                                    <RadioButton x:Name="RadioButton4" Content="아크릴 (깜빡일 수 있음)" MinWidth="170" ToolTip="아래 색으로 아크릴(Fluent) 배경을 씁니다." />
                                </WrapPanel>
                                <CheckBox x:Name="Checkbox10" Content="창을 최대화하면 기본 배경으로 되돌리기" Margin="0,6,0,0"
                                          ToolTip="창이 최대화되어 있으면 작업 표시줄을 기본 배경으로 되돌립니다." />
                                <CheckBox x:Name="tbsegments" Content="작업 표시줄 조각 (아이콘 부분에만 배경)"
                                          ToolTip="작업 표시줄 아이콘이 있는 부분에만 배경을 그립니다." />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="모서리 둥글기" VerticalAlignment="Center" Width="110" />
                                    <ui:NumberBox x:Name="tbrounding" Text="0" Width="100" PreviewTextInput="NumberValidationTextBox"
                                                  ToolTip="작업 표시줄 모서리를 둥글게 할 반지름(px)." />
                                    <TextBlock Text="px" Style="{StaticResource Sub}" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="색" Style="{StaticResource H2}" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="120" Height="120" VerticalAlignment="Top" Margin="0,0,20,0">
                                        <Image Source="grid.png" Stretch="Fill" />
                                        <Rectangle x:Name="colorprev" Fill="#FFF4F4F5" Stroke="#FF0E3A44" />
                                    </Grid>
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="34" />
                                            <RowDefinition Height="34" />
                                            <RowDefinition Height="34" />
                                            <RowDefinition Height="34" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="빨강" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Text="초록" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="2" Text="파랑" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="3" Text="알파" VerticalAlignment="Center" />
                                        <Slider x:Name="sRed" Grid.Row="0" Grid.Column="1" Maximum="255" VerticalAlignment="Center" ValueChanged="Red_ValueChanged" Foreground="#FFFF5A5A" />
                                        <Slider x:Name="sGreen" Grid.Row="1" Grid.Column="1" Maximum="255" VerticalAlignment="Center" ValueChanged="Green_ValueChanged" Foreground="#FF4CD964" />
                                        <Slider x:Name="sBlue" Grid.Row="2" Grid.Column="1" Maximum="255" VerticalAlignment="Center" ValueChanged="Blue_ValueChanged" Foreground="#FF4D8DFF" />
                                        <Slider x:Name="sAlpha" Grid.Row="3" Grid.Column="1" Maximum="100" VerticalAlignment="Center" ValueChanged="Alpha_ValueChanged" Foreground="#FF7FA9B5" />
                                        <TextBlock x:Name="tRed" Grid.Row="0" Grid.Column="2" Text="0" VerticalAlignment="Center" Margin="10,0,0,0" />
                                        <TextBlock x:Name="tGreen" Grid.Row="1" Grid.Column="2" Text="0" VerticalAlignment="Center" Margin="10,0,0,0" />
                                        <TextBlock x:Name="tBlue" Grid.Row="2" Grid.Column="2" Text="0" VerticalAlignment="Center" Margin="10,0,0,0" />
                                        <TextBlock x:Name="tAlpha" Grid.Row="3" Grid.Column="2" Text="0%" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="16진수" VerticalAlignment="Center" Width="60" />
                                    <TextBox x:Name="hexcolorbox" Text="TextBox" Width="110" />
                                    <Button FontFamily="Segoe MDL2 Assets" Content="&#xEF3C;" Width="40" Margin="8,0,0,0" Click="Button_Click_12"
                                            ToolTip="화면에서 색 고르기 (마우스 커서 위치의 색을 왼쪽 클릭으로 고릅니다)" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="전체 불투명도" Style="{StaticResource H2}" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="34" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="주 작업 표시줄" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Text="보조 작업 표시줄" VerticalAlignment="Center" />
                                    <Slider x:Name="tpop" Grid.Column="1" Maximum="100" VerticalAlignment="Center" Foreground="#FF7FA9B5" />
                                    <Slider x:Name="tsop" Grid.Row="1" Grid.Column="1" Maximum="100" VerticalAlignment="Center" Foreground="#FF7FA9B5" />
                                    <TextBlock x:Name="tpopla" Grid.Column="2" Text="0%" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    <TextBlock x:Name="tsopla" Grid.Row="1" Grid.Column="2" Text="0%" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 1 animation -->
            <TabItem>
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Text="애니메이션" Style="{StaticResource H1}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="애니메이션 종류" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="ComboBox1" Width="220" ToolTip="작업 표시줄 아이콘을 옮길 때 쓸 애니메이션." />
                                    <Button Content="&lt;" Width="34" Margin="8,0,0,0" Click="Button_Click_11" ToolTip="이전 항목" />
                                    <Button Content="&gt;" Width="34" Margin="4,0,0,0" Click="Button_Click_10" ToolTip="다음 항목" />
                                </StackPanel>
                                <TextBlock Text="배터리 사용 시 애니메이션" Margin="0,14,0,4" />
                                <ComboBox x:Name="ComboBox2" Width="220" ToolTip="노트북이 배터리로 동작할 때 쓸 애니메이션." />
                                <TextBlock Text="애니메이션 속도" Margin="0,14,0,4" />
                                <StackPanel Orientation="Horizontal">
                                    <ui:NumberBox x:Name="NumericUpDown4" Text="300" Width="110" PreviewTextInput="NumberValidationTextBox"
                                                  ToolTip="애니메이션 시간(밀리초)." />
                                    <TextBlock Text="ms" Style="{StaticResource Sub}" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="미리 보기" MinWidth="90" Click="Button_Click_9" ToolTip="지금 고른 애니메이션 설정을 미리 봅니다." />
                                <Slider x:Name="Slider1" Grid.Column="1" Maximum="1000" IsEnabled="False" VerticalAlignment="Center" Margin="14,0,0,0" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 2 position -->
            <TabItem>
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Text="위치" Style="{StaticResource H1}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="주 작업 표시줄 위치 보정" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal">
                                    <ui:NumberBox x:Name="NumericUpDown1" Text="0" Width="110" PreviewTextInput="NumberValidationTextBox"
                                                  ToolTip="주 작업 표시줄을 가운데에서 얼마나 옮길지(px). 음수는 '-'를 붙입니다." />
                                    <TextBlock Text="px" Style="{StaticResource Sub}" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="보조 작업 표시줄 위치 보정" Margin="0,14,0,4" />
                                <StackPanel Orientation="Horizontal">
                                    <ui:NumberBox x:Name="NumericUpDown2" Text="0" Width="110" PreviewTextInput="NumberValidationTextBox"
                                                  ToolTip="보조 작업 표시줄을 가운데에서 얼마나 옮길지(px). 음수는 '-'를 붙입니다." />
                                    <TextBlock Text="px" Style="{StaticResource Sub}" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
