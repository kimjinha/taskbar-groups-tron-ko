                            <StackPanel>
                                <CheckBox x:Name="CheckBox2" Content="주 작업 표시줄만 가운데 정렬" ToolTip="주 모니터의 작업 표시줄만 가운데로 맞춥니다." />
                                <CheckBox x:Name="CheckBox3" Content="보조 작업 표시줄만 가운데 정렬" ToolTip="보조 모니터의 작업 표시줄만 가운데로 맞춥니다." />
                                <CheckBox x:Name="CheckBox4" Content="작업 표시줄 도구 모음 위치 갱신" IsChecked="True"
                                          ToolTip="NetSpeedMonitor 같은 도구 모음이 있으면, 트레이 크기가 바뀔 때 도구 모음 위치를 다시 맞춥니다." />
                                <CheckBox x:Name="Checkbox9" Content="전체 화면 앱 실행 중에는 일시 정지"
                                          ToolTip="게임 등 전체 화면 앱이 실행 중이면 TaskbarX를 잠시 멈춥니다(일부 게임의 키 입력 문제 방지)." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="Checkbox12" Content="주 시작 버튼 숨기기" ToolTip="주 작업 표시줄의 시작 버튼을 숨깁니다." />
                                <CheckBox x:Name="Checkbox13" Content="보조 시작 버튼 숨기기" ToolTip="보조 작업 표시줄의 시작 버튼을 숨깁니다." />
                                <CheckBox x:Name="Checkbox14" Content="주 트레이 영역 숨기기" ToolTip="주 작업 표시줄의 시계 등 트레이 영역을 숨깁니다." />
                                <CheckBox x:Name="Checkbox15" Content="보조 트레이 영역 숨기기" ToolTip="보조 작업 표시줄의 시계 등 트레이 영역을 숨깁니다." />
                                <CheckBox x:Name="Checkbox16" Content="트레이 아이콘 표시" Visibility="Collapsed"
                                          ToolTip="TaskbarX를 빨리 다시 시작·중지하는 트레이 아이콘을 표시합니다." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 5 mechanics -->
            <TabItem>
                <ScrollViewer Style="{StaticResource Page}">
