                                    <Button x:Name="bb" Content="확인" Width="64" Margin="8,0,0,0" Style="{StaticResource AccentButtonStyle}" Click="Button_Click_4"
                                            ToolTip="새 버전이 있는지 확인합니다." />
                                    <TextBlock x:Name="vers" Text="연결 안 됨" Style="{StaticResource Sub}" Margin="10,0,0,0" />
                                </StackPanel>
                                <TextBox Grid.Row="1" Grid.Column="1" IsReadOnly="True" Text="Chris Andriessen" Margin="0,0,0,6" />
